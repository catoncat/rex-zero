{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.superlogical.rex-zero",
  "name": "rex-zero",
  "title": "Rex Zero",
  "version": "0.2.0",
  "engine": {
    "capabilities": {
      "requires": [
        "runtime.worker",
        "net.http",
        "text.glyphs.baked",
        "input.buttons",
        "input.text"
      ]
    }
  },
  "app": {
    "entry": "app/main.tsx",
    "output": "rex-zero",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [320, 170],
        "presentation": "native"
      }
    }
  },
  "domains": {
    "worker": {
      "entry": "app/worker.ts",
      "nodes": [{ "name": "http", "kind": "http" }],
      "channels": [
        {
          "name": "request",
          "kind": "ring",
          "direction": "ui-to-worker",
          "recordBytes": 1024,
          "capacity": 8
        },
        {
          "name": "response",
          "kind": "ring",
          "direction": "worker-to-ui",
          "recordBytes": 1024,
          "capacity": 8
        }
      ]
    }
  }
}
